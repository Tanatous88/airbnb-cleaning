# Timer mode: systemd runs one poll every 5 minutes. Pair with
# unifi-monitor-poll.service (Type=oneshot). Use this instead of
# unifi-monitor.service, not alongside it.
#
#   sudo cp deploy/unifi-monitor-poll.{timer,service} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now unifi-monitor-poll.timer

[Unit]
Description=Poll the UniFi controller every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
