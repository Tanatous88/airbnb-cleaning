# UniFi monitor configuration.
#
# Copy to a private location and lock it down:
#   cp .env.example ~/.unifi_monitor/env && chmod 600 ~/.unifi_monitor/env
#   export UNIFI_MONITOR_ENV=~/.unifi_monitor/env
# Anything already set in the real environment wins over this file.

# ---------------------------------------------------------------- controller
UNIFI_HOST=192.168.1.1
UNIFI_PORT=443
UNIFI_SITE=default
UNIFI_CONTROLLER_TYPE=proxy      # UniFi OS console (UDM/UDR/CK2+); "direct" for a software controller
UNIFI_VERIFY_SSL=false           # console uses a self-signed cert on the LAN

# Local console account, read-only. Do NOT use a Ubiquiti SSO account here —
# cloud accounts with MFA cannot log in to the local API.
UNIFI_USERNAME=monitor
UNIFI_PASSWORD=change-me
# Optional; the Integration API key exposes far less than the account above.
#UNIFI_API_KEY=

# ------------------------------------------------------------------- polling
UNIFI_POLL_INTERVAL=300          # seconds
UNIFI_DB_PATH=/var/lib/unifi-monitor/unifi_monitor.db
UNIFI_LOG_LEVEL=INFO
#UNIFI_LOG_FILE=/var/log/unifi-monitor.log
#UNIFI_MONITOR_CONFIG=/etc/unifi-monitor/config.json

# ---------------------------------------------------------------- watchlists
# Clients that matter. Comma-separated MACs or name fragments. Everything else
# is still recorded, but never raises an issue (phones sleep; that is not news).
UNIFI_CLIENT_WATCHLIST=cow cam,nvr,thermostat
#UNIFI_WATCH_ALL_CLIENTS=false
#UNIFI_IGNORE_LIST=guest-,chromecast

# ------------------------------------------------------------------ thresholds
UNIFI_DEVICE_OFFLINE_WARNING_S=300
UNIFI_DEVICE_OFFLINE_CRITICAL_S=900
UNIFI_CLIENT_OFFLINE_WARNING_S=600
UNIFI_CLIENT_OFFLINE_CRITICAL_S=1800
UNIFI_FLAP_WINDOW_S=3600
UNIFI_FLAP_WARNING_COUNT=3
UNIFI_FLAP_CRITICAL_COUNT=6
UNIFI_WAN_LATENCY_WARNING_MS=120
UNIFI_WAN_LATENCY_CRITICAL_MS=400
UNIFI_PORT_ERROR_RATE_WARNING=10
UNIFI_PORT_ERROR_RATE_CRITICAL=100
UNIFI_CPU_WARNING_PCT=85
UNIFI_SIGNAL_WARNING_DBM=-75
# 0 disables bandwidth flagging (throughput is always recorded either way)
UNIFI_BANDWIDTH_WARNING_BPS=0

# --------------------------------------------------------------------- alerts
# Comma-separated: slack, webhook, email, stdout
UNIFI_ALERT_CHANNELS=slack
UNIFI_ALERT_MIN_SEVERITY=warning
UNIFI_ALERT_COOLDOWN=3600
UNIFI_ALERT_ON_RESOLVE=true

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

#ALERT_WEBHOOK_URL=http://ai-pc:8080/hooks/unifi
#ALERT_WEBHOOK_AUTH=Authorization: Bearer abc123

#SMTP_HOST=smtp.fastmail.com
#SMTP_PORT=587
#SMTP_USER=alerts@example.com
#SMTP_PASSWORD=
#ALERT_EMAIL_FROM=alerts@example.com
#ALERT_EMAIL_TO=you@example.com

# ---------------------------------------------------------- part 2 (explain)
# Where confirmed/rejected action proposals are logged. Separate file on
# purpose: Part 2 opens the monitoring db read-only.
#UNIFI_ACTIONS_DB=/var/lib/unifi-monitor/unifi_actions.db
# Leave false. Enabling it is only half the story — the account must also have
# write permission, which today's view-only account does not.
UNIFI_ALLOW_WRITE_ACTIONS=false
