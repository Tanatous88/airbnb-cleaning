# Copy this file to .env and fill in your Anthropic API key.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: morning summary email (Settings → Morning summary email).
# Sent from your own Gmail account. Use a Gmail *app password*, not your normal
# password: Google Account → Security → 2-Step Verification → App passwords.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GREETING_STUDIO_DB=greeting_studio.db
